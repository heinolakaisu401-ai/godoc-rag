# ===== 通义千问 DashScope 配置 =====
# 在 https://dashscope.console.aliyun.com 申请 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容接口地址（一般不用改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型
LLM_MODEL=qwen-plus

# Embedding 模型（注意：维度必须和 scripts/setup.sql 里的 vector(1024) 一致）
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024

# ===== RAG 链路可调参数（用评测迭代时改这里即可）=====
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_CANDIDATE_K=20
RAG_USE_RERANK=true

# ===== PostgreSQL（pgvector）=====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/godoc_rag?sslmode=disable

# ===== 服务端口 =====
SERVER_PORT=8080
